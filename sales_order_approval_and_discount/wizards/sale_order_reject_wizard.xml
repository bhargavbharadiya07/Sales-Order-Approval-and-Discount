<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_reject_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.reject.wizard.form</field>
        <field name="model">sale.order.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Sale Order">
                <group>
                    <field name="reason"/>
                </group>
                <footer>
                    <button string="Reject" type="object" name="action_reject_order" class="btn btn-primary"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="sale_order_reject_wizard_action" model="ir.actions.act_window">
        <field name="name">Reject Sale Order</field>
        <field name="res_model">sale.order.reject.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
