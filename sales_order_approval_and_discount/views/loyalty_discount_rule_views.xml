<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_loyalty_discount_rule_form" model="ir.ui.view">
        <field name="name">loyalty.discount.rule.form</field>
        <field name="model">loyalty.discount.rule</field>
        <field name="arch" type="xml">
            <form string="Loyalty Discount Rule">
                <group>
                    <field name="name"/>
                    <field name="min_purchase"/>
                    <field name="min_orders"/>
                    <field name="discount_percentage"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_loyalty_discount_rule_tree" model="ir.ui.view">
        <field name="name">loyalty.discount.rule.tree</field>
        <field name="model">loyalty.discount.rule</field>
        <field name="arch" type="xml">
            <tree string="Loyalty Discount Rules" editable="bottom">
                <field name="name"/>
                <field name="min_purchase"/>
                <field name="min_orders" />
                <field name="discount_percentage"/>
            </tree>
        </field>
    </record>

    <record id="action_loyalty_discount_rule" model="ir.actions.act_window">
        <field name="name">Loyalty Discount Rules</field>
        <field name="res_model">loyalty.discount.rule</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem id="menu_loyalty_discount_rule" name="Loyalty Discount Rules"
              parent="sale.menu_sale_config" action="action_loyalty_discount_rule"/>
</odoo>
